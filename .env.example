# Copy to .env. Never commit real credentials.
# Optional: barcode lookup still works without an AI key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
PORT=3000
# Set 0.0.0.0 explicitly in a container or for trusted LAN testing.
HOST=127.0.0.1
AI_TIMEOUT_MS=30000
AI_MAX_CONCURRENCY=2
AI_DAILY_LIMIT=100
# Leave 0 without a reverse proxy; set the exact trusted hop count otherwise.
TRUST_PROXY_HOPS=0
